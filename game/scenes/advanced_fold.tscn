[gd_scene format=3]

[node name="Advanced" type="VBoxContainer"]
theme_override_constants/separation = 8

[node name="Toggle" type="Button" parent="."]
layout_mode = 2
toggle_mode = true
text = "Advanced settings"
alignment = 0

[node name="Tag" type="Label" parent="Toggle"]
layout_mode = 1
anchors_preset = 6
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_left = -132.0
offset_top = -10.0
offset_right = -14.0
offset_bottom = 10.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 2
text = "TEST BUILDS ONLY"
horizontal_alignment = 1
theme_type_variation = &"Tag"

[node name="RelayHelp" type="Label" parent="."]
layout_mode = 2
visible = false
text = "Relay server: matches players online. Test builds only; leave it unless you are trying another relay."
autowrap_mode = 3
theme_type_variation = &"Hint"

[node name="RelayUrl" type="LineEdit" parent="."]
layout_mode = 2
visible = false
placeholder_text = "Relay URL"
