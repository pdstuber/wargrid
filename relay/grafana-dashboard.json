{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "Wargrid relay",
 "uid": "wargrid-relay",
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "templating": {
  "list": [
   {
    "name": "app",
    "type": "custom",
    "query": "wargrid-relay,wargrid-relay-jvm",
    "current": {
     "text": "wargrid-relay",
     "value": "wargrid-relay"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Rooms and seats",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "wargrid_relay_rooms{app=\"$app\"}",
     "legendFormat": "rooms"
    },
    {
     "refId": "B",
     "expr": "wargrid_relay_seats{app=\"$app\"}",
     "legendFormat": "seats"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Joins by result (per min)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (rate(wargrid_relay_joins_total{app=\"$app\"}[5m])) * 60",
     "legendFormat": "{{result}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Matches per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(wargrid_relay_matches_started_total{app=\"$app\"}[1h]))",
     "legendFormat": "started"
    },
    {
     "refId": "B",
     "expr": "sum(increase(wargrid_relay_matches_ended_total{app=\"$app\"}[1h]))",
     "legendFormat": "ended"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Match duration",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(wargrid_relay_match_duration_seconds_bucket{app=\"$app\"}[6h])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum by (le) (rate(wargrid_relay_match_duration_seconds_bucket{app=\"$app\"}[6h])))",
     "legendFormat": "p90"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Tick frames",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(wargrid_relay_frames_total{app=\"$app\"}[1m]))",
     "legendFormat": "frames/s"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Frame bytes",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(wargrid_relay_frame_bytes_total{app=\"$app\"}[1m]))",
     "legendFormat": "in"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Connections (per min)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(wargrid_relay_connections_opened_total{app=\"$app\"}[5m])) * 60",
     "legendFormat": "opened"
    },
    {
     "refId": "B",
     "expr": "sum(rate(wargrid_relay_connections_closed_total{app=\"$app\"}[5m])) * 60",
     "legendFormat": "closed"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Problems per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(wargrid_relay_messages_rejected_total{app=\"$app\"}[1h]))",
     "legendFormat": "rejected messages"
    },
    {
     "refId": "B",
     "expr": "sum(increase(wargrid_relay_room_crashes_total{app=\"$app\"}[1h]))",
     "legendFormat": "room crashes"
    },
    {
     "refId": "C",
     "expr": "max(wargrid_relay_draining{app=\"$app\"})",
     "legendFormat": "draining"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Go runtime",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "go_goroutines{app=\"$app\"}",
     "legendFormat": "goroutines"
    },
    {
     "refId": "B",
     "expr": "go_memstats_heap_alloc_bytes{app=\"$app\"} / 1e6",
     "legendFormat": "heap MB"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "GC pause per second",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(go_gc_duration_seconds_sum{app=\"$app\"}[5m])",
     "legendFormat": "gc"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Machine CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (rate(fly_instance_cpu{app=\"$app\"}[1m]))",
     "legendFormat": "{{mode}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Machine memory and proxy concurrency",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fly_instance_memory_mem_total{app=\"$app\"} - fly_instance_memory_mem_available{app=\"$app\"}",
     "legendFormat": "used bytes"
    },
    {
     "refId": "B",
     "expr": "fly_app_concurrency{app=\"$app\"}",
     "legendFormat": "concurrency"
    }
   ]
  }
 ]
}
